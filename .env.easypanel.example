# Modelo das variaveis do docker-compose.easypanel.yml (aba Environment do servico Compose no EasyPanel).
# Nao coloque valores reais neste arquivo: ele vai para o git.

# Enderecos publicos (os dominios criados na aba Domains), sem barra no fim
JOGO_URL=https://jogo-xxxx.easypanel.host
LOGIN_URL=https://login-xxxx.easypanel.host

# Senhas obrigatorias: gere senhas longas e aleatorias
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# Seu e-mail: vira ADMIN do jogo no primeiro login (cadastre-se logo apos o primeiro deploy)
ADMIN_EMAILS=

# Binance Link/Broker: usado pelo wallet-service para criar subcontas e enviar BTC
BINANCE_SUBCONTAS_HABILITADO=true
BINANCE_SUBCONTAS_MODO=STANDARD
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_URL=https://api.binance.com

# Deriv: usado pela flecha V100. Em DEMO o jogo não envia ordens reais.
# Para operação real, preencha o token e app ID e altere somente o modo para REAL.
DERIV_API_TOKEN=
DERIV_APP_ID=
DERIV_TRADING_MODE=DEMO
# Opcional: se vazio, o trading-service seleciona a conta correspondente ao modo.
DERIV_ACCOUNT_ID=

# Opcionais
ABACATEPAY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Carteira: moedas de boas-vindas (contas novas) e cupom (um uso por conta). 1 real = 1 moeda.
CARTEIRA_SALDO_INICIAL=0
CUPOM_CODIGO=30COINS
CUPOM_MOEDAS=30

# Desconto ao devolver em moedas as flechas de mercado nao usadas ao sair do campo (0.002 = 0,2%)
FLECHA_TAXA_DEVOLUCAO=0.002
